def _normalize_text(value: str) -> str:
    if not value:
        return 
    normalized = unicodedata.normalize(NFKD, value)
    normalized = .join(ch for ch in normalized if not unicodedata.combining(ch))
    normalized = normalized.lower()
    return re.sub(r[^a-z0-9]+,  , normalized).strip()


def _extract_duckduckgo_url(raw_href: str) -> str:
    if not raw_href:
        return 
    if duckduckgo.com/l/? in raw_href or raw_href.startswith(/l/?):
        parsed = requests.utils.urlparse(raw_href)
        params = requests.utils.parse_qs(parsed.query)
        uddg = params.get(uddg)
        if uddg:
            return requests.utils.unquote(uddg[0])
    if raw_href.startswith(http):
        return raw_href
    return 


def _city_hint(company: Dict) -> str:
    if company.get(city):
        return company[city]
    address = company.get(address, )
    if address:
        parts = [p.strip() for p in address.split(,) if p.strip()]
        if parts:
            return parts[-1]
    return company.get(location, )


def _get_headless_searcher() -> Optional[HeadlessGoogleSearcher]:
    global _headless_instance
    with _headless_lock:
        if _headless_instance is None:
            try:
                _headless_instance = HeadlessGoogleSearcher(headless=True)
            except Exception:
                _headless_instance = None
    return _headless_instance


def _get_cse_service():
    global _cse_service
    if _cse_service is not None:
        return _cse_service
    if not _GOOGLE_CSE_SERVICE_ACCOUNT_FILE:
        return None
    scopes = [https://www.googleapis.com/auth/cse]
    try:
        creds = service_account.Credentials.from_service_account_file(
            _GOOGLE_CSE_SERVICE_ACCOUNT_FILE,
            scopes=scopes,
        )
        _cse_service = google_build(customsearch, v1, credentials=creds, cache_discovery=False)
    except Exception:
        _cse_service = None
    return _cse_service


def generate_search_queries(name: str, city: str, voivodeship: str) -> List[str]:
    base = f{name} {city}.strip()
    if not openai.api_key:
        return [q for q in [base, f{name} oficjalna strona, f{name} kontakt] if q]
    prompt = f
Nazwa podmiotu: {name}
Miasto/region: {city or 'brak'}
Województwo: {voivodeship or 'brak'}
Przygotuj maksymalnie 3 różne zapytania Google, które pomogą znaleźć oficjalną stronę lub kontakt.
Zwróć numerowaną listę.

    try:
        response = openai.chat.completions.create(
            model=gpt-4o-mini,
            temperature=0.2,
            messages=[
                {role: system, content: Tworzysz skuteczne zapytania Google},
                {role: user, content: prompt},
            ],
        )
        content = response.choices[0].message.content.strip()
        record_openai_usage(max(len(content) // 4, 120), query_generation)
        queries: List[str] = []
        for line in content.splitlines():
            line = line.strip()
            if not line:
                continue
            if line[0].isdigit():
                parts = line.split(., 1)
                if len(parts) == 2:
                    queries.append(parts[1].strip())
                else:
                    queries.append(line)
            else:
                queries.append(line)
        return [q for q in queries if q] or [base]
    except Exception:
        return [base]


def rank_candidates_with_ai(query: str, candidates: List[Dict]) -> Tuple[str, str]:
    if not candidates:
        return , 
    if not openai.api_key:
        return candidates[0][url], Brak klucza OpenAI – wybrano pierwszy wynik
    summary = [
        fSzukamy oficjalnej strony pasującej do zapytania '{query}'.,
        Preferuj domeny należące do podmiotu. Unikaj katalogów i plików PDF.,
        ,
    ]
    for idx, cand in enumerate(candidates, start=1):
        summary.append(f{idx}. {cand['title']} — {cand['url']} — {cand.get('snippet','')})
    summary.append(Odpowiedz numerem lub adresem URL. Jeśli nic nie pasuje, napisz 'NONE'.)
    messages = [
        {role: system, content: Jesteś asystentem wybierającym najlepszy wynik wyszukiwania},
        {role: user, content: \n.join(summary)},
    ]
    try:
        response = openai.chat.completions.create(
            model=gpt-4o-mini,
            messages=messages,
            temperature=0,
        )
        content = response.choices[0].message.content.strip()
        record_openai_usage(max((len(summary[-1]) + len(content)) // 4, 150), site_verification)
    except Exception as exc:
        return candidates[0][url], fBłąd OpenAI: {exc}
    if none in content.lower():
        return , content
    match_url = re.search(rhttps?://\S+, content)
    if match_url:
        return match_url.group(0).rstrip().,;), content
    match_num = re.search(r\b(\d+)\b, content)
    if match_num:
        idx = int(match_num.group(1)) - 1
        if 0 <= idx < len(candidates):
            return candidates[idx][url], content
    return candidates[0][url], content


def _filter_html_candidates(candidates: List[Dict]) -> List[Dict]:
    filtered = []
    for cand in candidates:
        url = cand.get(url, )
        if not url.startswith((http://, https://)):
            continue
        path = requests.utils.urlparse(url).path.lower()
        if path.endswith((.pdf, .doc, .docx, .xls, .xlsx, .zip)):
            continue
        filtered.append(cand)
    return filtered


def _duckduckgo_fetch(query: str, endpoint: str, use_proxy: bool = False) -> Optional[requests.Response]:
    params = {q: query}
    for attempt in range(4):
        try:
            headers = {
                User-Agent: random.choice(_USER_AGENTS),
                Accept-Language: pl-PL,pl;q=0.9,en-US;q=0.8,
                Referer: https://duckduckgo.com/,
            }
            target = endpoint
            if use_proxy:
                parsed = requests.utils.urlparse(endpoint)
                target = _PROXY_BASE.format(host=parsed.netloc, path=parsed.path or /)
                headers[User-Agent] = curl/7.79.1
                headers[Referer] = https://r.jina.ai/
            resp = _DDG_SESSION.get(target, params=params, headers=headers, timeout=15)
            if resp.status_code in (403, 429):
                time.sleep(2 ** attempt + random.random())
                continue
            resp.raise_for_status()
            return resp
        except Exception:
            time.sleep(2 ** attempt + 0.5)
    return None


def _parse_duckduckgo_html(html: str) -> List[Dict]:
    soup = BeautifulSoup(html, html.parser)
    candidates = []
    for result in soup.select(div.result):
        link = result.select_one(a.result__a)
        if not link:
            continue
        href = _extract_duckduckgo_url(link.get(href))
        if not href:
            continue
        snippet = 
        snippet_loc = result.select_one(div.result__snippet)
        if snippet_loc:
            snippet = snippet_loc.get_text( , strip=True)
        candidates.append({url: href, title: link.get_text( , strip=True), snippet: snippet})
        if len(candidates) >= 5:
            break
    return candidates


def _parse_duckduckgo_lite(html: str) -> List[Dict]:
    soup = BeautifulSoup(html, html.parser)
    candidates = []
    for row in soup.select(tr):
        link = row.select_one(a)
        if not link or not link.get(href):
            continue
        href = _extract_duckduckgo_url(link.get(href))
        if not href.startswith((http://, https://)):
            continue
        snippet = 
        sibling = row.find_next_sibling(tr)
        if sibling:
            snippet = sibling.get_text( , strip=True)
        candidates.append({url: href, title: link.get_text( , strip=True), snippet: snippet})
        if len(candidates) >= 5:
            break
    return candidates


def _parse_ddgs_results(results: List[Dict]) -> List[Dict]:
    logger.info(Parsing CSE results: %d entries, len(results))
    candidates = []
    for item in results:
        url = item.get(href) or item.get(url) or item.get(link)
        if not url or not url.startswith((http://, https://)):
            continue
        host = requests.utils.urlparse(url).netloc.lower()
        if any(skip in host for skip in _SKIP_DOMAINS):
            continue
        candidates.append({
            url: url,
            title: item.get(title, ),
            snippet: item.get(body) or item.get(snippet) or item.get(htmlSnippet) or ,
        })
        if len(candidates) >= 5:
            break
    return candidates


def _google_custom_search(query: str) -> Optional[List[Dict]]:
    if _GOOGLE_CSE_KEY and _GOOGLE_CSE_CX:
        params = {
            key: _GOOGLE_CSE_KEY,
            cx: _GOOGLE_CSE_CX,
            q: query,
            num: 8,
            gl: pl,
            hl: pl,
            safe: active,
        }
        try:
            logger.info(CSE HTTP GET | query=%s | params=%s, query, params)
            resp = requests.get(https://www.googleapis.com/customsearch/v1, params=params, timeout=15)
            logger.info(CSE HTTP response | status=%s | body=%s, resp.status_code, resp.text[:500])
            resp.raise_for_status()
            return _parse_ddgs_results(resp.json().get(items, []))
        except Exception as exc:
            logger.warning(CSE request failed for '%s': %s, query, exc)
            return []
    service = _get_cse_service()
    if not service or not _GOOGLE_CSE_CX:
        return None
    try:
        response = (
            service.cse()
            .list(q=query, cx=_GOOGLE_CSE_CX, num=8, gl=pl, hl=pl, safe=active)
            .execute()
        )
        logger.info(CSE service response for '%s': keys=%s, query, list(response.keys()))
        return _parse_ddgs_results(response.get(items, []))
    except Exception as exc:
        logger.warning(CSE service-account request failed for '%s': %s, query, exc)
        return []


def _collect_search_candidates(query: str, subject: str) -> Tuple[List[Dict], str]:
    Compatibility wrapper used by the chat agent.
    return _collect_candidates(query)


def _collect_candidates(query: str) -> Tuple[List[Dict], str]:
    cse = _google_custom_search(query)
    if cse:
        logger.info(Candidates from CSE for '%s': %d, query, len(cse))
        return cse, Google Custom Search API
    logger.info(CSE returned no results for '%s', trying DuckDuckGo., query)
    resp = _duckduckgo_fetch(query, _DDG_HTML)
    if resp:
        cands = _parse_duckduckgo_html(resp.text)
        if cands:
            logger.info(DuckDuckGo HTML returned %d candidates for '%s'., len(cands), query)
            return cands, DuckDuckGo HTML
    resp = _duckduckgo_fetch(query, _DDG_LITE)
    if resp:
        cands = _parse_duckduckgo_lite(resp.text)
        if cands:
            logger.info(DuckDuckGo Lite returned %d candidates for '%s'., len(cands), query)
            return cands, DuckDuckGo Lite
    logger.warning(All candidate sources empty for '%s'., query)
    return [], Brak odpowiedzi


def discover_company_website(company: Dict, status_callback: Optional[Callable[[str], None]] = None) -> str:
    name = (company.get(name) or ).strip()
    if not name:
        return 
    city = (_city_hint(company) or ).strip()
    voivodeship = company.get(voivodeship_canonical) or company.get(voivodeship) or 
    cache_key = f{name}|{city}.lower()
    if cache_key in _SITE_SEARCH_CACHE:
        return _SITE_SEARCH_CACHE[cache_key]

    queries = generate_search_queries(name, city, voivodeship)
    searcher = _get_headless_searcher()

    for idx, query in enumerate(queries, start=1):
        if status_callback:
            status_callback(f[{idx}/{len(queries)}] {query})
        if searcher:
            try:
                headless_results = searcher.search(query, limit=6)
                filtered = _filter_html_candidates(headless_results)
                if filtered:
                    best_url, reasoning = rank_candidates_with_ai(query, filtered)
                    if best_url:
                        _SITE_SEARCH_CACHE[cache_key] = best_url
                        if status_callback:
                            status_callback(f? {best_url} ({reasoning}))
                        return best_url
            except Exception:
                searcher = None

        candidates, source = _collect_candidates(query)
        filtered = _filter_html_candidates(candidates)
        if filtered:
            if len(filtered) == 1 or not openai.api_key:
                best_url = filtered[0][url]
                reasoning = Tylko jeden wynik.
            else:
                best_url, reasoning = rank_candidates_with_ai(query, filtered)
            if best_url:
                _SITE_SEARCH_CACHE[cache_key] = best_url
                logger.info(Website candidate selected for '%s': %s via %s, name, best_url, source)
                if status_callback:
                    status_callback(f? {best_url} ({source}))
                return best_url
    if status_callback:
        status_callback(?? Nie znaleziono oficjalnej strony)
    _SITE_SEARCH_CACHE[cache_key] = 
    return 


def enrich_company_profile(company: Dict, config: Dict, status_callback: Optional[Callable[[str], None]] = None) -> Dict:
    enriched = dict(company)
    website_url = enriched.get(website) or discover_company_website(enriched, status_callback=status_callback)
    if website_url:
        enriched[website] = website_url
        crawl = scrape_company_website(enriched.get(name, ), website_url) or {}
        if crawl:
            enriched = merge_company_data(enriched, crawl, {})
    enriched = validate_company_data(enriched)
    return enriched
